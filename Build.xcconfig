// A certificate-backed identity keeps macOS privacy grants stable across builds.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development

// Defaults for a checkout that has not run the scripts yet. Both generated files
// are ignored by git, so no version or certificate is ever committed.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1

// Generated by scripts/configure-signing.py using existing keychain certificates.
#include? "Signing.local.xcconfig"
// Generated by scripts/configure-version.py from git.
#include? "Version.local.xcconfig"
